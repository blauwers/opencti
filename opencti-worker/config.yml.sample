---
opencti:
  url: 'http://localhost:8080'
  token: 'ChangeMe'
  json_logging: true
  batch_requests_timeout: 3600
  batch_requests_max_payload_size: 50331648
  batch_requests_max_execution_groups: 1024 # Set to 0 to disable the execution-group bound

worker:
  log_level: 'info'
  telemetry_enabled: false
  objects_max_refs: 0
